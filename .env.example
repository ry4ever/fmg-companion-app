# Environment variables for FMG functions
# Copy to .env and fill in your values

# Firebase Admin SDK
FIREBASE_PROJECT_ID=fmg-app
FIREBASE_PRIVATE_KEY=your-private-key-here
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SECRET_KEY=sk_live_your_secret_key

# Encharge (marketing automation)
ENCHARGE_API_KEY=your_encharge_api_key
ENCHARGE_WELCOME_TEMPLATE_ID=your_template_id
ENCHARGE_SHIRT_NOTIFICATION_TEMPLATE_ID=your_shirt_template_id