{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassExt": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "prettyPrint": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "files": [
    "next-env.d"
  ],
  "references": []
}