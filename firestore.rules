rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users collection - top-level user documents
    // Read/write only via UID-based ownership checks
    // Direct client writes are blocked - only backend functions can provision
    match /users/{userId} {
      allow read: if isAuthenticated() &&
                     (resource.data.uid == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Telemetry subcollection
      // Athletes can only create their own telemetry
      // No updates allowed (write-once for integrity)
      match /telemetry/{sessionId} {
        allow read: if isAuthenticated() &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'athlete';
        allow create: if isAuthenticated() &&
                        request.resource.data.keys().hasAll(['session_id', 'started_at', 'completed_at']) &&
                        request.resource.data.completed_fully is bool;
        allow update: if false;
        allow delete: if false;
      }

      // Schedules subcollection
      // Athletes can read their own schedules
      // Schedules are managed by the system
      match /schedules/{scheduleId} {
        allow read: if isAuthenticated() &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'athlete';
        allow write: if false;
      }
    }
  }
}
