rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users collection - top-level user documents
    // Authenticated users can read/write their own document by auth UID.
    // This lets the mobile app provision its own profile and the parent
    // portal read linked athlete data without a backend round-trip.
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      // Telemetry subcollection
      // Athletes can only create their own telemetry
      // No updates allowed (write-once for integrity)
      match /telemetry/{sessionId} {
        allow read: if isAuthenticated() &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'athlete';
        allow create: if isAuthenticated() &&
                        request.resource.data.keys().hasAll(['session_id', 'started_at', 'completed_at']) &&
                        request.resource.data.completed_fully is bool;
        allow update: if false;
        allow delete: if false;
      }

      // Schedules subcollection
      // Athletes can read their own schedules
      // Schedules are managed by the system
      match /schedules/{scheduleId} {
        allow read: if isAuthenticated() &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'athlete';
        allow write: if false;
      }
    }
  }
}
